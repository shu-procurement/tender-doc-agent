# 生成随机签名密钥：python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# 复制为 .env 后填入自己的密钥；切勿把 .env 提交到仓库
FLASK_SECRET_KEY=please-generate-a-random-string

DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions

# Dify 自建或云端地址，工作流端点为 <DIFY_BASE_URL>/workflows/run
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_RECOGNIZE_API_KEY=app-your-recognize-workflow-key
DIFY_GENERATE_API_KEY=app-your-generate-workflow-key
DIFY_COMPLIANCE_API_KEY=app-your-compliance-workflow-key
DIFY_ARGUMENT_API_KEY=app-your-contract-workflow-key
DIFY_BID_COLLUSION_API_KEY=app-your-collusion-workflow-key

BAIDU_OCR_API_KEY=your-baidu-ocr-ak
BAIDU_OCR_SECRET_KEY=your-baidu-ocr-sk

AI_AGENT_BASE_URL=http://127.0.0.1:8000
DEFAULT_COMPANY_NAME=示例采购单位
